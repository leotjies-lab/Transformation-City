rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Anyone can submit the "I'm New Here" form, and admin portal can manage submissions
    match /submissions/{submissionId} {
      allow create: if request.resource.data.firstName is string
                    && request.resource.data.email is string;
      allow read, update, delete: if true;
    }

    // Admin records
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // TCC Events collection - Public read, write access for management
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Custom Forms - Public read for active forms, full access for admin management
    match /custom_forms/{formId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Custom Form Submissions - Public create, read/update/delete for admin management
    match /custom_submissions/{submissionId} {
      allow create: if request.resource.data.formId is string;
      allow read, update, delete: if true;
    }

    // Sermons & Media Collateral - Public read for published sermons, full access for admin management
    match /sermons/{sermonId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
