{
  "entities": {
    "submissions": {
      "title": "I'm New Submissions",
      "description": "Form submissions from I'm New Here connect cards",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "interestedIn": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "contacted", "followed-up", "archived"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["firstName", "lastName", "email", "interestedIn", "status", "createdAt"]
    },
    "admins": {
      "title": "Admin Users",
      "description": "Authorized TCC Admin team users",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "events": {
      "title": "TCC Events",
      "description": "Upcoming and recurring calendar events for Transformation City Church",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string", "description": "Date in YYYY-MM-DD format" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "color": { "type": "string" },
        "recurrence": { "type": "string", "enum": ["none", "weekly", "monthly", "yearly"] },
        "cancelledDates": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "date"]
    },
    "custom_forms": {
      "title": "Custom Forms",
      "description": "Admin created church forms with destination options",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "destination": { "type": "string", "enum": ["save", "email", "save_and_email"] },
        "fields": { "type": "array" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "ownerEmail", "destination", "fields", "active", "createdAt"]
    },
    "custom_submissions": {
      "title": "Custom Form Submissions",
      "description": "Submissions collected for custom church forms",
      "type": "object",
      "properties": {
        "formId": { "type": "string" },
        "formTitle": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "destination": { "type": "string" },
        "answers": { "type": "object" },
        "status": { "type": "string", "enum": ["new", "contacted", "followed-up", "archived"] },
        "adminNotes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["formId", "formTitle", "answers", "status", "createdAt"]
    }
  },
  "firestore": {
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/submissions" },
      "description": "Form submissions"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/admins" },
      "description": "Admin users"
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/events" },
      "description": "Calendar events for TCC"
    },
    "/custom_forms/{formId}": {
      "schema": { "$ref": "#/entities/custom_forms" },
      "description": "Custom church forms"
    },
    "/custom_submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/custom_submissions" },
      "description": "Submissions for custom church forms"
    }
  }
}
